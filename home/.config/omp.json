{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": false,
    "notice": false
  },
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "leading_diamond": "\u256d\u2500\ue0b6",
          "template": "{{.Icon}} ",
          "foreground": "#000000",
          "background": "#d3d7cf",
          "type": "os",
          "style": "diamond"
        },
        {
          "properties": {
            "home_icon": "~",
            "style": "full"
          },
          "template": " \uf07c {{ .Path | abbrev 32 }} ",
          "foreground": "7",
          "powerline_symbol": "\ue0b8",
          "background": "4",
          "type": "path",
          "style": "powerline"
        },
        {
          "properties": {
            "branch_icon": "\uf126 ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ .UpstreamIcon }}{{ (abbrev 28 .HEAD) }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "foreground": "#000000",
          "powerline_symbol": "\ue0b0",
          "background": "2",
          "type": "git",
          "style": "powerline",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}3{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}2{{ end }}",
            "{{ if gt .Ahead 0 }}#89d1dc{{ end }}",
            "{{ if gt .Behind 0 }}#4e9a06{{ end }}"
          ]
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "filler": "<darkGray>·</>",
      "trailing_diamond": "<7,default>─╮</>",
      "segments": [
        {
          "template": " {{ .FormattedMs }} \uf252 ",
          "foreground": "0",
          "leading_diamond": "\ue0b2",
          "background": "3",
          "type": "executiontime",
          "style": "diamond",
          "invert_powerline": true
        },
        {
          "properties": {
            "always_enabled": true
          },
          "template": " {{ if gt .Code 0 }}{{ .Code }}{{ else }}\uf42e{{ end }} ",
          "foreground": "0",
          "leading_diamond": "\ue0b2",
          "background": "2",
          "type": "status",
          "style": "diamond",
          "background_templates": [
            "{{ if gt .Code 0 }}1{{ end }}"
          ],
          "invert_powerline": true
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "\u2570\u2500",
          "foreground": "#d3d7cf",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": true
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "template": "\u2500\u256f",
          "foreground": "#d3d7cf",
          "type": "text",
          "style": "plain"
        }
      ]
    }
  ],
  "version": 3,
  "final_space": true
}
